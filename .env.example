# TypeSafe AI Jev (System One) Configuration
# API docs: https://api.typesafe.ai
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# Generator LLM Configuration (OpenAI, OpenRouter, or local vLLM/Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Optional: Default Sufficiency Gate Threshold (0.50 to 0.95, default: 0.70)
SUFFICIENCY_THRESHOLD=0.70
